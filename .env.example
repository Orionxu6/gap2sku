# Gap2SKU AgentTeams Demo — environment template.
# Copy to .env.local and fill in, or run `make configure-api`. Never commit it.

# --- LLM / AgentTeams ---
MODEL_PROVIDER=openai-compat
MODEL_NAME=deepseek-v4-flash
LEADER_MODEL_NAME=deepseek-v4-flash
MARKET_MODEL_NAME=deepseek-v4-flash
SUPPLY_MODEL_NAME=deepseek-v4-flash
ECONOMICS_MODEL_NAME=deepseek-v4-flash
REVIEWER_MODEL_NAME=deepseek-v4-flash
PROTOTYPE_MODEL_NAME=deepseek-v4-flash
COMPLIANCE_MODEL_NAME=deepseek-v4-flash
GAP2SKU_AGENT_CONTRACT_LOADER=strict
DEMO_SEED=20260812
AGENTTEAMS_TAG=v1.2.2
AGENTTEAMS_VERSION=v1.2.2
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_DEFAULT_MODEL=deepseek-v4-flash
AGENTTEAMS_LLM_API_KEY=
AGENTTEAMS_OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENTTEAMS_MODEL_CONTEXT_WINDOW=1000000
AGENTTEAMS_MODEL_MAX_TOKENS=384000
AGENTTEAMS_MODEL_REASONING=true
AGENTTEAMS_MODEL_VISION=false
AGENTTEAMS_EMBEDDING_MODEL=
AGENTTEAMS_MANAGER_RUNTIME=copaw
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=qwenpaw
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=
AGENTTEAMS_INSTALL_URL=https://raw.githubusercontent.com/agentscope-ai/AgentTeams/v1.2.2/install/agentteams-install.sh
ELEMENT_WEB_URL=http://127.0.0.1:18088
MANAGER_ROOM=manager
GAP2SKU_TEAM_NAME=gap2sku-definition
GAP2SKU_TEAM_LEADER=gap2sku-product-architect

# --- Gap2SKU MCP ---
GAP2SKU_MCP_BASE_URL=http://host.docker.internal:18090
GAP2SKU_MCP_HOST=0.0.0.0
GAP2SKU_MCP_PORT=18090
# On Linux, cloud_deploy auto-detects a gateway IP if host.docker.internal is unavailable:
# GAP2SKU_MCP_BASE_URL=http://172.18.0.1:18090

# --- Storage ---
GAP2SKU_DB_PATH=shared/gap2sku.db
GAP2SKU_NAP_DB_PATH=shared/nap_pillow.db
GAP2SKU_MINIO_ENDPOINT=
GAP2SKU_MINIO_ACCESS_KEY=
GAP2SKU_MINIO_SECRET_KEY=
GAP2SKU_MINIO_BUCKET=gap2sku

# --- Demo admin (optional, Human CR) ---
DEMO_ADMIN_EMAIL=admin@example.invalid

# --- Feature flags ---
GAP2SKU_LIVE_DATA=0
GAP2SKU_PLAYWRIGHT=0
GAP2SKU_BRAVE_SEARCH=0
GAP2SKU_AGENTLOOP=0

# --- Local Matrix / AgentTeams observer (fill only after local runtime starts) ---
MATRIX_HOMESERVER=http://127.0.0.1:18080
MATRIX_ROOM_ID=
MATRIX_OBSERVER_ACCESS_TOKEN=
MATRIX_OBSERVER_USER_ID=
MATRIX_ROLE_MAP_JSON={}

# --- Independent online image provider; this is NOT the AgentTeams text key ---
QWEN_IMAGE_ENDPOINT=
QWEN_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_API_KEY=
