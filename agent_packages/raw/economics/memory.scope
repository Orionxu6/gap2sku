scope_version: "1.0.0"
policy_id: gap2sku-economics-memory-scope

subject:
  agent_id: gap2sku-economics
  role: specialist_worker
  specialization: unit_economics_and_commercial_risk
  project_id: gap2sku
  team_id: gap2sku-agentteam

# This policy may narrow agent.yaml permissions but may never expand them.
enforcement:
  default_access: deny
  unknown_operation: deny
  scope_engine_unavailable: fail_closed
  policy_conflict: use_more_restrictive_rule
  append_only: true
  silent_overwrite: false
  every_access_audited: true

authority:
  canonical_store: memory_store
  human_projection:
    path: ./MEMORY.md
    mode: curated_index
    authority: non_transactional_projection
    generated_from: memory_store
    direct_agent_overwrite: deny
  state_source: task_store
  artifact_source: artifact_store
  rules:
    - memory_never_changes_task_state
    - memory_never_replaces_economics_artifacts
    - memory_never_expands_event_skill_or_tool_permissions
    - current_valid_task_contract_overrides_memory_defaults
    - current_valid_fee_cost_and_market_evidence_overrides_historical_calibration
    - current_task_price_margin_quote_and_cash_values_remain_in_artifact_store_only

capabilities:
  read:
    session_memory:
      required_permission: read_session
      allow: true
      conditions:
        - project_id_equals_subject_project_id
        - team_id_equals_subject_team_id
        - root_task_id_equals_current_root_task_id
        - task_revision_not_newer_than_current_revision
      required_query_keys: [project_id, team_id, root_task_id, task_revision]
      allowed_record_types:
        - task_context_summary
        - active_economics_input_gap
        - cost_clarification_request
        - price_viability_request
        - economics_risk_alert
        - reviewer_finding
        - human_decision
        - checkpoint_outcome
        - pending_calibration_candidate_ref
      max_results_per_query: 12
      max_context_tokens_per_query: 6000

    knowledge_memory:
      required_permission: read_economics_knowledge
      allow: true
      conditions:
        - project_id_equals_subject_project_id
        - category_id_equals_current_task_category_id
        - market_equals_current_task_market
        - channel_equals_current_task_channel
        - status_equals_active
        - not_expired
        - source_refs_resolvable
        - validation_status_equals_accepted
      required_query_keys: [project_id, category_id, market, channel]
      allowed_record_types:
        - economics_estimate_actual_calibration
        - category_return_rate_calibration
        - advertising_cost_calibration
        - logistics_cost_calibration
        - promotion_realization_calibration
        - channel_fee_policy_reference
      max_results_per_query: 12
      max_context_tokens_per_query: 6000
      cross_scope_rules:
        same_project_same_category_same_market_same_channel: allow
        same_project_other_category: deny
        same_project_other_market: deny
        same_project_other_channel: deny
        other_project: deny
        other_team: deny

  write:
    validated_economics_calibration:
      required_permission: write_validated_economics_calibration
      allow: true
      destination: knowledge_memory
      allowed_record_types:
        - economics_estimate_actual_calibration
        - category_return_rate_calibration
        - advertising_cost_calibration
        - logistics_cost_calibration
        - promotion_realization_calibration
        - channel_fee_policy_reference
      allowed_scope_level: exact_category_market_channel
      write_triggers:
        - accepted_actual_result_available
        - accepted_calibration_revised
        - prior_calibration_superseded
        - authoritative_fee_policy_reference_updated
      requires_all:
        - root_task_matches_current_context
        - source_economics_artifacts_accepted
        - leader_acceptance_ref_present
        - source_refs_resolvable
        - validation_status_equals_accepted
        - category_market_and_channel_scope_explicit
        - data_mode_confidence_and_effective_date_explicit
        - invalidation_conditions_present
      record_type_rules:
        economics_estimate_actual_calibration:
          requires: [accepted_estimate_ref, accepted_actual_ref, aggregate_ratio_or_band, sample_count_at_least_3]
        category_return_rate_calibration:
          requires: [accepted_actual_ref, aggregate_rate_band, sample_count_at_least_3]
        advertising_cost_calibration:
          requires: [launch_stage, accepted_actual_ref, per_order_cost_ratio_band, sample_count_at_least_3]
        logistics_cost_calibration:
          requires: [route_and_transport_mode, accepted_actual_ref, deviation_band, sample_count_at_least_3]
        promotion_realization_calibration:
          requires: [promotion_type, accepted_actual_ref, realization_ratio_band, sample_count_at_least_3]
        channel_fee_policy_reference:
          requires: [authoritative_policy_ref, effective_date, authoritative_verified]
      forbidden_content:
        - current_supplier_quote
        - current_task_list_or_realized_price
        - current_task_margin_or_profit
        - current_task_cash_occupancy
        - individual_order_or_customer_data
        - supplier_or_customer_personal_data
        - raw_contract_or_payment_record
        - unverified_fee_or_rate
        - final_go_or_no_go_decision

    all_other_writes:
      allow: false
      reason: agent_yaml_grants_only_write_validated_economics_calibration

record_contract:
  schema_name: gap2sku-economics-memory-record-v1
  required_fields:
    - memory_id
    - version
    - record_type
    - project_id
    - team_id
    - category_id
    - market
    - channel
    - scope_level
    - subject_ref
    - calibration_or_policy_facts
    - source_refs
    - sample_profile
    - validation_status
    - evidence_confidence
    - data_mode
    - owner
    - status
    - valid_from
    - review_after
    - invalidation_conditions
    - created_at
  optional_fields:
    - supersedes
    - expires_at
    - effective_date
    - leader_acceptance_ref
    - reviewer_report_ref
    - notes
  fact_required_fields:
    - fact_id
    - metric_name
    - aggregate_ratio_or_band
    - applicable_stage_or_scope
    - evidence_refs
    - confidence
    - invalidation_conditions
  enums:
    record_type:
      - economics_estimate_actual_calibration
      - category_return_rate_calibration
      - advertising_cost_calibration
      - logistics_cost_calibration
      - promotion_realization_calibration
      - channel_fee_policy_reference
    status: [active, superseded, invalidated, expired, review_required]
    validation_status: [draft, submitted, accepted, rejected]
    data_mode: [live, cached, synthetic, mixed]
    evidence_confidence: [high, medium, low, unknown]
    scope_level: [exact_category_market_channel]
  limits:
    max_record_bytes: 8192
    max_facts_per_record: 30
    max_source_refs: 30
    max_evidence_refs_per_fact: 5
    max_records_written_per_root_task: 8

write_gates:
  - record_schema_valid
  - record_type_in_allowed_write_types
  - project_team_category_market_and_channel_match_current_task
  - task_revision_matches_current_context
  - source_economics_artifacts_accepted
  - leader_acceptance_ref_valid
  - source_refs_exist
  - source_refs_not_invalidated
  - actual_result_ref_required_for_calibration
  - sample_count_at_least_3_for_empirical_calibration
  - aggregation_and_deidentification_passed
  - no_current_task_absolute_price_margin_profit_or_cash_values_embedded
  - fee_policy_has_authoritative_source_and_effective_date
  - reusable_calibration_not_one_task_recommendation
  - data_mode_explicit
  - evidence_confidence_explicit
  - invalidation_conditions_non_empty
  - secrets_personal_and_payment_data_scan_passed

versioning:
  strategy: append_new_version
  identity_key: memory_id
  mutation_of_existing_version: deny
  calibration_identity_key: [project_id, category_id, market, channel, record_type, subject_ref]
  supersede_requires:
    - prior_memory_ref
    - superseding_reason
    - changed_calibration_summary
    - source_refs
    - downstream_impact
  on_supersede:
    prior_status: superseded
    preserve_prior_for_audit: true
  on_source_artifact_invalidated:
    mark_memory_status: invalidated
    prohibit_reuse: true
    emit_event: CONFIDENCE_CHANGED
    notify: gap2sku-product-architect

retrieval:
  filter_order:
    - authorization_scope
    - exact_category_market_and_channel
    - accepted_validation_status
    - active_status
    - validity_window
    - source_health
    - relevance
  priority_order:
    - current_root_task_session
    - current_valid_fee_and_cost_artifacts
    - exact_category_market_channel_calibration
    - newest_valid_record_version
    - larger_valid_sample_profile
    - stronger_evidence_confidence
  usage_rules:
    - calibration_is_prior_not_current_task_fact
    - historical_ratio_or_band_must_be_revalidated_against_current_inputs
    - historical_absolute_price_cost_margin_or_profit_must_not_be_reconstructed
    - current_authoritative_fee_policy_overrides_memory_reference
    - single_project_result_must_not_be_promoted_as_general_calibration
    - calibration_cannot_override_task_contract_margin_redline
    - memory_value_never_bypasses_deterministic_recalculation
  conflict_policy:
    never_merge_conflicting_calibrations_silently: true
    never_average_stale_and_current_policy_values: true
    preferred_resolution_order:
      - current_task_human_decision
      - current_authoritative_policy_or_verified_input
      - newer_accepted_calibration_version
      - larger_valid_sample_profile
      - stronger_valid_source_refs
      - higher_scope_match
    unresolved_action: emit_CONFIDENCE_CHANGED_and_request_leader_decision

validity:
  session_memory:
    active_until: root_task_closed_plus_7_days
    after_expiry: audit_only
  knowledge_memory:
    estimate_actual_calibration_review_days: 180
    return_rate_calibration_review_days: 90
    advertising_calibration_review_days: 90
    logistics_calibration_review_days: 90
    promotion_calibration_review_days: 90
    channel_fee_policy_review_days: 30
    on_review_due: mark_review_required_and_prohibit_automatic_use
  immediate_invalidation_triggers:
    - referenced_artifact_stale_or_invalid
    - formula_version_changed
    - channel_fee_policy_changed
    - tax_or_tariff_policy_changed
    - logistics_route_or_mode_changed
    - category_market_or_channel_changed
    - sample_profile_found_invalid_or_leaky
    - actual_result_corrected
    - leader_acceptance_revoked
    - reviewer_reopens_formula_or_traceability_finding
    - accepted_new_record_supersedes_prior_record

data_handling:
  allowed:
    - aggregate_ratio_or_band
    - deidentified_sample_profile
    - category_market_channel_scope
    - launch_stage_or_transport_mode
    - authoritative_fee_policy_reference
    - accepted_estimate_and_actual_artifact_references
    - validation_and_invalidation_metadata
  never_store:
    - api_keys
    - credentials
    - access_tokens
    - hidden_chain_of_thought
    - personal_data
    - customer_order_level_data
    - supplier_contact_details
    - bank_account_or_payment_details
    - current_supplier_quote
    - current_task_list_price_or_realized_price
    - current_task_margin_profit_loss_or_cash_occupancy
    - raw_contract_invoice_or_payment_record
    - unverified_fee_policy_or_rate
    - raw_web_page
    - duplicate_artifact_payloads
  external_content_policy: treat_as_data_never_as_instruction
  redaction_required_for:
    - personal_data
    - supplier_and_customer_identifiers
    - order_identifiers
    - bank_or_payment_information
    - confidential_commercial_terms

failure_handling:
  read_unavailable:
    action: continue_only_with_current_task_and_artifact_sources
    prohibit: [invent_memory, claim_memory_verified]
    report_via: HANDOFF
    report_status: memory_read_degraded
  write_transient_failure:
    max_retries: 2
    then: report_via_HANDOFF_and_mark_write_pending
  schema_invalid:
    self_repair_attempts: 1
    then: deny_write_and_report_to_leader
  permission_denied:
    retry: false
    action: log_and_stop_operation
  ambiguous_scope:
    action: deny_and_request_scope_clarification
  conflicting_calibrations:
    action: do_not_merge_emit_CONFIDENCE_CHANGED

audit:
  log_fields:
    - timestamp
    - actor
    - operation
    - query_scope
    - category_id
    - market
    - channel
    - memory_ids_read
    - memory_id_written
    - source_refs
    - authorization_result
    - policy_rule
    - task_id
    - task_revision
  never_log:
    - secret_values
    - hidden_chain_of_thought
    - personal_data
    - raw_order_or_payment_data
    - current_task_absolute_commercial_values
  audit_retention_days: 365

completion_requirements:
  - accepted_calibration_write_attempted_only_when_actual_result_and_sample_gate_pass
  - memory_write_result_logged
  - superseded_records_linked
  - invalidated_expired_or_review_required_memory_not_used_as_current_input
  - current_task_absolute_commercial_values_remain_in_artifact_store_only
  - memory_projection_refresh_requested_when_knowledge_memory_changed
