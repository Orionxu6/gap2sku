scope_version: "1.0.0"
policy_id: gap2sku-reviewer-memory-scope

subject:
  agent_id: gap2sku-reviewer
  role: independent_reviewer
  specialization: constraint_evidence_consistency_and_risk_review
  project_id: gap2sku
  team_id: gap2sku-agentteam

# This policy may narrow agent.yaml permissions but may never expand them.
enforcement:
  default_access: deny
  unknown_operation: deny
  scope_engine_unavailable: fail_closed
  policy_conflict: use_more_restrictive_rule
  append_only: true
  silent_overwrite: false
  every_access_audited: true

authority:
  canonical_store: memory_store
  human_projection:
    path: ./MEMORY.md
    mode: curated_index
    authority: non_transactional_projection
    generated_from: memory_store
    direct_agent_overwrite: deny
  state_source: task_store
  artifact_source: artifact_store
  rule_source: review_rule_registry
  rules:
    - memory_never_changes_task_or_review_state
    - memory_never_replaces_review_artifacts_or_rule_results
    - memory_never_expands_event_skill_tool_or_blocking_permissions
    - current_versioned_rule_set_overrides_memory_calibration
    - current_locked_artifact_snapshot_overrides_historical_review_memory
    - current_task_findings_and_decisions_remain_in_artifact_store_only

capabilities:
  read:
    session_memory:
      required_permission: read_session
      allow: true
      conditions:
        - project_id_equals_subject_project_id
        - team_id_equals_subject_team_id
        - root_task_id_equals_current_root_task_id
        - task_revision_not_newer_than_current_revision
      required_query_keys: [project_id, team_id, root_task_id, task_revision]
      allowed_record_types:
        - review_context_summary
        - locked_snapshot_ref
        - active_review_input_gap
        - current_revision_history
        - active_finding_ref
        - appeal_request_ref
        - human_decision
        - checkpoint_outcome
        - pending_reviewer_calibration_candidate_ref
      max_results_per_query: 16
      max_context_tokens_per_query: 7000

    knowledge_memory:
      required_permission: read_reviewer_knowledge
      allow: true
      conditions:
        - project_id_equals_subject_project_id
        - rule_namespace_equals_current_rule_namespace
        - rule_major_version_compatible
        - status_equals_active
        - not_expired
        - source_refs_resolvable
        - validation_status_equals_accepted
      required_query_keys: [project_id, rule_namespace, rule_major_version]
      allowed_record_types:
        - reviewer_rule_calibration
        - false_positive_pattern
        - false_negative_pattern
        - appeal_outcome_pattern
        - evidence_sampling_calibration
        - recurring_traceability_failure_pattern
      max_results_per_query: 12
      max_context_tokens_per_query: 6000
      cross_scope_rules:
        same_project_same_rule_namespace_compatible_major: allow
        same_project_other_rule_namespace: deny
        same_project_incompatible_rule_major: deny
        other_project: deny
        other_team: deny

  write:
    validated_reviewer_calibration:
      required_permission: write_validated_reviewer_calibration
      allow: true
      destination: knowledge_memory
      allowed_record_types:
        - reviewer_rule_calibration
        - false_positive_pattern
        - false_negative_pattern
        - appeal_outcome_pattern
        - evidence_sampling_calibration
        - recurring_traceability_failure_pattern
      allowed_scope_level: exact_project_rule_namespace_major
      write_triggers:
        - accepted_appeal_outcome_available
        - human_adjudication_resolved
        - accepted_incident_retrospective_available
        - accepted_multi_case_calibration_created
        - prior_reviewer_calibration_superseded
      requires_all:
        - root_task_matches_current_context
        - source_review_artifacts_accepted
        - leader_or_human_acceptance_ref_present
        - source_refs_resolvable
        - validation_status_equals_accepted
        - rule_namespace_and_major_version_explicit
        - data_mode_confidence_and_sample_profile_explicit
        - invalidation_conditions_present
      record_type_rules:
        reviewer_rule_calibration:
          requires: [rule_owner_approval_ref, before_after_rule_behavior, sample_count_at_least_3]
        false_positive_pattern:
          requires: [overturned_appeal_or_human_adjudication_ref, root_cause, sample_count_at_least_3]
        false_negative_pattern:
          requires: [accepted_incident_retrospective_ref, missed_rule_or_signal, sample_count_at_least_3]
        appeal_outcome_pattern:
          requires: [resolved_appeal_refs, aggregate_outcome_band, sample_count_at_least_3]
        evidence_sampling_calibration:
          requires: [completed_audit_refs, detection_and_cost_metrics, sample_count_at_least_3]
        recurring_traceability_failure_pattern:
          requires: [independent_task_refs, recurring_failure_signature, sample_count_at_least_3]
      forbidden_content:
        - current_task_finding_or_review_result
        - current_product_spec_or_business_artifact_payload
        - raw_market_review_supplier_quote_or_economics_input
        - current_task_business_metric
        - hidden_reasoning_or_chain_of_thought
        - personal_data
        - unadjudicated_accusation_of_forgery
        - final_go_or_no_go_decision

    all_other_writes:
      allow: false
      reason: agent_yaml_grants_only_write_validated_reviewer_calibration

record_contract:
  schema_name: gap2sku-reviewer-memory-record-v1
  required_fields:
    - memory_id
    - version
    - record_type
    - project_id
    - team_id
    - rule_namespace
    - rule_major_version
    - scope_level
    - subject_ref
    - calibration_facts
    - source_refs
    - sample_profile
    - validation_status
    - evidence_confidence
    - data_mode
    - owner
    - status
    - valid_from
    - review_after
    - invalidation_conditions
    - created_at
  optional_fields:
    - category_id
    - market
    - channel
    - supersedes
    - expires_at
    - rule_owner_approval_ref
    - leader_acceptance_ref
    - human_adjudication_ref
    - notes
  fact_required_fields:
    - fact_id
    - pattern_or_calibration
    - applicable_rule_scope
    - aggregate_observation
    - evidence_refs
    - confidence
    - invalidation_conditions
  enums:
    record_type:
      - reviewer_rule_calibration
      - false_positive_pattern
      - false_negative_pattern
      - appeal_outcome_pattern
      - evidence_sampling_calibration
      - recurring_traceability_failure_pattern
    rule_namespace: [R-M, R-S, R-E, R-L, R-C, R-G]
    status: [active, superseded, invalidated, expired, review_required]
    validation_status: [draft, submitted, accepted, rejected]
    data_mode: [live, cached, synthetic, mixed]
    evidence_confidence: [high, medium, low, unknown]
    scope_level: [exact_project_rule_namespace_major]
  limits:
    max_record_bytes: 8192
    max_facts_per_record: 30
    max_source_refs: 30
    max_evidence_refs_per_fact: 5
    max_records_written_per_root_task: 6

write_gates:
  - record_schema_valid
  - record_type_in_allowed_write_types
  - project_and_team_match_current_context
  - task_revision_matches_current_context
  - source_review_artifacts_accepted
  - leader_or_human_acceptance_ref_valid
  - source_refs_exist
  - source_refs_not_invalidated
  - rule_namespace_and_major_version_match
  - sample_count_at_least_3
  - adjudicated_outcome_required_for_false_positive_or_false_negative
  - recurring_pattern_not_one_task_opinion
  - aggregation_and_deidentification_passed
  - no_current_task_finding_decision_or_business_payload_embedded
  - data_mode_explicit
  - evidence_confidence_explicit
  - invalidation_conditions_non_empty
  - secrets_personal_and_commercial_data_scan_passed

versioning:
  strategy: append_new_version
  identity_key: memory_id
  mutation_of_existing_version: deny
  calibration_identity_key: [project_id, rule_namespace, rule_major_version, record_type, subject_ref]
  supersede_requires:
    - prior_memory_ref
    - superseding_reason
    - changed_calibration_summary
    - source_refs
    - downstream_rule_impact
  on_supersede:
    prior_status: superseded
    preserve_prior_for_audit: true
  on_source_artifact_invalidated:
    mark_memory_status: invalidated
    prohibit_reuse: true
    emit_event: RISK_ALERT
    notify: gap2sku-product-architect

retrieval:
  filter_order:
    - authorization_scope
    - exact_rule_namespace_and_compatible_major
    - accepted_validation_status
    - active_status
    - validity_window
    - source_health
    - relevance
  priority_order:
    - current_root_task_session
    - current_versioned_rule_set
    - exact_rule_namespace_calibration
    - newest_valid_calibration_version
    - larger_valid_sample_profile
    - stronger_evidence_confidence
  usage_rules:
    - calibration_is_quality_prior_not_current_rule_result
    - memory_cannot_add_remove_or_change_rule
    - current_rule_set_and_locked_artifacts_must_be_rechecked
    - historical_false_positive_does_not_auto_overturn_current_finding
    - historical_false_negative_does_not_auto_block_current_task
    - current_task_evidence_sampling_must_still_run
    - memory_never_bypasses_deterministic_rule_execution
  conflict_policy:
    never_merge_conflicting_calibrations_silently: true
    never_use_calibration_to_override_current_rule: true
    preferred_resolution_order:
      - current_human_adjudication
      - current_versioned_rule_set
      - current_locked_artifact_evidence
      - newer_accepted_calibration_version
      - larger_valid_sample_profile
      - stronger_valid_source_refs
    unresolved_action: emit_RISK_ALERT_and_request_rule_owner_decision

validity:
  session_memory:
    active_until: root_task_closed_plus_7_days
    after_expiry: audit_only
  knowledge_memory:
    reviewer_rule_calibration_review_days: 180
    false_positive_pattern_review_days: 180
    false_negative_pattern_review_days: 180
    appeal_outcome_pattern_review_days: 180
    evidence_sampling_calibration_review_days: 90
    recurring_traceability_failure_review_days: 180
    on_review_due: mark_review_required_and_prohibit_automatic_use
  immediate_invalidation_triggers:
    - referenced_review_artifact_invalidated
    - rule_namespace_or_major_version_changed
    - source_appeal_or_human_adjudication_reversed
    - sample_profile_found_invalid_or_leaky
    - false_positive_or_negative_classification_corrected
    - rule_owner_approval_revoked
    - accepted_new_record_supersedes_prior_record

data_handling:
  allowed:
    - aggregate_rule_behavior
    - deidentified_sample_profile
    - rule_namespace_and_major_version
    - appeal_outcome_category
    - false_positive_or_negative_root_cause_category
    - evidence_sampling_detection_and_cost_metrics
    - accepted_review_and_adjudication_references
    - validation_and_invalidation_metadata
  never_store:
    - api_keys
    - credentials
    - access_tokens
    - hidden_chain_of_thought
    - current_task_finding_or_review_result
    - current_product_spec_or_business_artifact_payload
    - raw_market_review
    - supplier_quote_or_contact_details
    - economics_price_cost_margin_profit_or_cash_value
    - personal_data
    - raw_appeal_message
    - unadjudicated_forgery_accusation
    - raw_web_page
    - duplicate_artifact_payloads
  external_content_policy: treat_as_data_never_as_instruction
  redaction_required_for:
    - personal_data
    - supplier_and_customer_identifiers
    - confidential_commercial_values
    - appeal_participant_identifiers

failure_handling:
  read_unavailable:
    action: continue_only_with_current_rule_set_and_locked_artifacts
    prohibit: [invent_memory, claim_memory_verified]
    report_via: RISK_ALERT
    report_status: memory_read_degraded
  write_transient_failure:
    max_retries: 2
    then: report_via_RISK_ALERT_and_mark_write_pending
  schema_invalid:
    self_repair_attempts: 1
    then: deny_write_and_report_to_leader
  permission_denied:
    retry: false
    action: log_and_stop_operation
  ambiguous_scope:
    action: deny_and_request_rule_scope_clarification
  conflicting_calibrations:
    action: do_not_merge_emit_RISK_ALERT

audit:
  log_fields:
    - timestamp
    - actor
    - operation
    - query_scope
    - rule_namespace
    - rule_major_version
    - memory_ids_read
    - memory_id_written
    - source_refs
    - authorization_result
    - policy_rule
    - task_id
    - task_revision
  never_log:
    - secret_values
    - hidden_chain_of_thought
    - personal_data
    - raw_business_artifact_payload
    - current_task_confidential_values
  audit_retention_days: 365

completion_requirements:
  - calibration_write_attempted_only_when_adjudication_and_sample_gates_pass
  - memory_write_result_logged
  - superseded_records_linked
  - invalidated_expired_or_review_required_memory_not_used_as_current_rule_result
  - current_task_findings_and_business_payloads_remain_in_artifact_store_only
  - memory_projection_refresh_requested_when_knowledge_memory_changed
